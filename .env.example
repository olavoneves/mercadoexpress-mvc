# Copie este arquivo para .env e preencha com as credenciais reais.
# O arquivo .env esta no .gitignore e NUNCA deve ser commitado.
# Mantenha os valores VAZIOS aqui: este arquivo e versionado no GitHub.

DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USER=
DB_PASSWORD=

# Perfil ativo: vazio/ausente = Oracle | dev = H2 em memoria
SPRING_PROFILES_ACTIVE=

# Porta HTTP (default 8080; a Parte I usa 8082)
PORT=8080
